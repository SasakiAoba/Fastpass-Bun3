{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "types": ["@cloudflare/workers-types"],
    "noEmit": true,
    "allowImportingTsExtensions": false
  },
  "include": ["functions/**/*.ts", "src/shared/**/*.ts", "src/domain/types.ts", "src/config/fastpass.config.ts"]
}
