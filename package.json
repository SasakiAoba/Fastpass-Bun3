{
  "name": "bun3-fastpass",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json --pretty false && vite build",
    "preview": "vite preview",
    "test": "vitest run --reporter=verbose --pool=threads --maxWorkers=1 --no-file-parallelism",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.app.json --pretty false"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^26.1.0",
    "typescript": "~5.8.3",
    "vite": "^7.1.5",
    "vitest": "^5.0.0"
  }
}
